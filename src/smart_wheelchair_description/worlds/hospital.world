<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="hospital_world">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 23 0 1.5707 1.5707</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!--
      Larger hospital layout for Nav2/A* demo.
      Overall footprint: 18m x 12m, with a horizontal corridor and a
      vertical corridor crossing through patient rooms, nurse areas, storage,
      and waiting rooms.
    -->
    <model name="hospital_structure">
      <static>true</static>

      <!-- Outer boundary -->
      <link name="wall_outer_north">
        <pose>0 6 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>18.4 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>18.4 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_outer_south">
        <pose>0 -6 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>18.4 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>18.4 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_outer_west">
        <pose>-9 0 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 12.4 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 12.4 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_outer_east">
        <pose>9 0 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 12.4 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 12.4 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>

      <!-- Horizontal corridor room-front walls, with wide door gaps. -->
      <link name="wall_upper_front_l1">
        <pose>-8.7 1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.6 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_upper_front_l2">
        <pose>-6.0 1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_upper_front_l3">
        <pose>-3.25 1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.7 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_upper_front_l4">
        <pose>-1.25 1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>

      <link name="wall_upper_front_r1">
        <pose>1.25 1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_upper_front_r2">
        <pose>3.25 1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.7 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_upper_front_r3">
        <pose>6.0 1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_upper_front_r4">
        <pose>8.7 1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.6 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>

      <link name="wall_lower_front_l1">
        <pose>-8.7 -1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.6 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_lower_front_l2">
        <pose>-6.0 -1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_lower_front_l3">
        <pose>-3.25 -1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.7 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_lower_front_l4">
        <pose>-1.25 -1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>

      <link name="wall_lower_front_r1">
        <pose>1.25 -1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_lower_front_r2">
        <pose>3.25 -1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.7 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_lower_front_r3">
        <pose>6.0 -1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <link name="wall_lower_front_r4">
        <pose>8.7 -1.2 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.6 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.2 2</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>

      <!-- Room partitions and vertical corridor side walls. -->
      <link name="wall_top_room_split_l1"><pose>-6 3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
      <link name="wall_top_room_split_l2"><pose>-3 3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
      <link name="wall_top_cross_west"><pose>-1.2 3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
      <link name="wall_top_cross_east"><pose>1.2 3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
      <link name="wall_top_room_split_r1"><pose>3 3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
      <link name="wall_top_room_split_r2"><pose>6 3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>

      <link name="wall_bottom_room_split_l1"><pose>-6 -3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
      <link name="wall_bottom_room_split_l2"><pose>-3 -3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
      <link name="wall_bottom_cross_west"><pose>-1.2 -3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
      <link name="wall_bottom_cross_east"><pose>1.2 -3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
      <link name="wall_bottom_room_split_r1"><pose>3 -3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
      <link name="wall_bottom_room_split_r2"><pose>6 -3.6 1 0 0 0</pose><collision name="collision"><geometry><box><size>0.2 4.8 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.8 2</size></box></geometry><material><script><name>Gazebo/Wood</name></script></material></visual></link>
    </model>

    <model name="hospital_furniture">
      <static>true</static>

      <!-- Beds and exam tables in patient rooms. -->
      <link name="bed_room_a"><pose>-7.5 4.1 0.3 0 0 0</pose><collision name="collision"><geometry><box><size>1.8 0.85 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.85 0.6</size></box></geometry><material><script><name>Gazebo/Blue</name></script></material></visual></link>
      <link name="bed_room_b"><pose>-4.5 4.1 0.3 0 0 0</pose><collision name="collision"><geometry><box><size>1.8 0.85 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.85 0.6</size></box></geometry><material><script><name>Gazebo/Blue</name></script></material></visual></link>
      <link name="exam_table_c"><pose>-2.1 4.0 0.35 0 0 0</pose><collision name="collision"><geometry><box><size>1.1 0.75 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.1 0.75 0.7</size></box></geometry><material><script><name>Gazebo/Green</name></script></material></visual></link>
      <link name="nurse_desk"><pose>2.1 3.9 0.45 0 0 0</pose><collision name="collision"><geometry><box><size>1.2 0.8 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 0.8 0.9</size></box></geometry><material><script><name>Gazebo/Orange</name></script></material></visual></link>
      <link name="bed_room_d"><pose>4.5 4.1 0.3 0 0 0</pose><collision name="collision"><geometry><box><size>1.8 0.85 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.85 0.6</size></box></geometry><material><script><name>Gazebo/Blue</name></script></material></visual></link>
      <link name="bed_room_e"><pose>7.5 4.1 0.3 0 0 0</pose><collision name="collision"><geometry><box><size>1.8 0.85 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.85 0.6</size></box></geometry><material><script><name>Gazebo/Blue</name></script></material></visual></link>

      <link name="bed_room_f"><pose>-7.5 -4.1 0.3 0 0 0</pose><collision name="collision"><geometry><box><size>1.8 0.85 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.85 0.6</size></box></geometry><material><script><name>Gazebo/Blue</name></script></material></visual></link>
      <link name="bed_room_g"><pose>-4.5 -4.1 0.3 0 0 0</pose><collision name="collision"><geometry><box><size>1.8 0.85 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.85 0.6</size></box></geometry><material><script><name>Gazebo/Blue</name></script></material></visual></link>
      <link name="storage_shelf"><pose>-2.1 -4.0 0.75 0 0 0</pose><collision name="collision"><geometry><box><size>1.1 0.65 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.1 0.65 1.5</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual></link>
      <link name="waiting_chair_bank"><pose>2.1 -4.0 0.35 0 0 0</pose><collision name="collision"><geometry><box><size>1.2 0.55 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 0.55 0.7</size></box></geometry><material><script><name>Gazebo/Yellow</name></script></material></visual></link>
      <link name="bed_room_h"><pose>4.5 -4.1 0.3 0 0 0</pose><collision name="collision"><geometry><box><size>1.8 0.85 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.85 0.6</size></box></geometry><material><script><name>Gazebo/Blue</name></script></material></visual></link>
      <link name="bed_room_i"><pose>7.5 -4.1 0.3 0 0 0</pose><collision name="collision"><geometry><box><size>1.8 0.85 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.85 0.6</size></box></geometry><material><script><name>Gazebo/Blue</name></script></material></visual></link>

      <!-- Corridor carts placed near edges so A* must route around them. -->
      <link name="corridor_cart_west"><pose>-5.2 0.65 0.45 0 0 0</pose><collision name="collision"><geometry><box><size>0.45 0.45 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.45 0.45 0.9</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual></link>
      <link name="corridor_cart_east"><pose>5.2 -0.65 0.45 0 0 0</pose><collision name="collision"><geometry><box><size>0.45 0.45 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.45 0.45 0.9</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual></link>
      <link name="cross_corridor_cart"><pose>0.65 4.8 0.45 0 0 0</pose><collision name="collision"><geometry><box><size>0.45 0.45 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.45 0.45 0.9</size></box></geometry><material><script><name>Gazebo/Red</name></script></material></visual></link>
    </model>

    <!-- HUMAN ACTOR: stays in the main corridor for follow-me demo. -->
    <actor name="human_target">
      <skin>
        <filename>file:///usr/share/gazebo-11/media/models/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>file:///usr/share/gazebo-11/media/models/walk.dae</filename>
        <scale>1.000000</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.000000</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>2.2 0 0 0 0 0</pose></waypoint>
          <waypoint><time>10</time><pose>3.4 0 0 0 0 0</pose></waypoint>
          <waypoint><time>20</time><pose>2.2 0 0 0 0 3.14</pose></waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
